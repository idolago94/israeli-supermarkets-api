# ─── catalog-api environment ─────────────────────────────────────────────────
# Copy to `.env` for local `vercel dev`, and set the same keys in the Vercel
# project settings (Environment Variables) for production.

# MongoDB Atlas connection string (SRV). The catalog lives in this cluster.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
# Database name inside the cluster.
MONGODB_DB="catalog"

# Read API key — the mobile app sends this in the `x-api-key` header on every
# catalog request. Any long random string.
CATALOG_API_KEY="<long-random-string>"

# Sync secret — required by /api/sync/* so only trusted callers can trigger a
# catalog sync. The scheduler (.github/workflows/catalog-sync.yml) sends it in
# `x-sync-secret`. Any long random string, different from CATALOG_API_KEY.
SYNC_SECRET="<long-random-string>"

# ─── Catalog v2 (Postgres) ────────────────────────────────────────────────────
# Only needed once you start calling /api/v2/*. Any Postgres works (lib/pg.ts
# just points the `postgres` driver at DATABASE_URL) — this project provisions
# it via the Vercel Marketplace (`vercel integration add neon`, or `supabase`
# if you prefer). Use the *pooled* connection string, not the direct one,
# which would exhaust Postgres' connection limit under concurrent serverless
# invocations — a Neon install already sets DATABASE_URL to its pooled
# endpoint (hostname ends in `-pooler`); on Supabase pick "Transaction" pooler
# mode, port 6543. Apply supabase/migrations/*.sql (`psql "$DATABASE_URL" -f
# supabase/migrations/*.sql`, or the provider's SQL editor) before the first
# v2 sync.
DATABASE_URL="postgresql://<user>:<password>@<pooled-host>/<database>"

# ─── GitHub Actions secrets ──────────────────────────────────────────────────
# The scheduler lives in this repo, not on the hosting platform. Set these two
# under Settings → Secrets and variables → Actions:
#
#   CATALOG_API_BASE   https://<project>.vercel.app   (no trailing slash)
#   SYNC_SECRET        exactly the same value as SYNC_SECRET above
