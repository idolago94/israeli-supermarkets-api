# ─── Catalog sync service configuration ──────────────────────────────────────
# Copy to sync-service/.env and fill in. A variable set in the real
# environment overrides this file.

# Target catalog (v2 Postgres). Use a direct or session-pooler connection.
# For Supabase's transaction pooler (port 6543) also set SYNC_PG_PREPARE=false.
SYNC_DATABASE_URL=postgres://user:password@host:5432/postgres
# SYNC_PG_PREPARE=true
# SYNC_PG_POOL_SIZE=16

# Dashboard. Bound to this machine only by default.
# SYNC_HOST=127.0.0.1
# SYNC_PORT=4100
# Base URL used in links from GitHub issues back to the dashboard.
# SYNC_PUBLIC_URL=http://localhost:4100

# Where the SQLite history and raw files live (relative to sync-service/).
# SYNC_DATA_DIR=data

# Chains to sync (comma-separated ids from lib/chains.ts); empty = all.
# SYNC_CHAINS=osher_ad,rami_levy,yohananof,tiv_taam

# Timezone of the schedule's cron patterns.
# SYNC_TIMEZONE=Asia/Jerusalem

# Branches processed at once inside one chain (chains always run in parallel).
# SYNC_BRANCH_CONCURRENCY=3

# Retries for transient errors (network, 5xx, timeouts, dropped DB connection).
# SYNC_MAX_ATTEMPTS=3
# SYNC_BACKOFF_BASE_MS=2000
# SYNC_BACKOFF_MAX_MS=60000
# SYNC_MAX_RELOGINS=2

# Circuit breaker: stop a chain once more than this share of its finished
# branches failed (after at least MIN_SAMPLES finished).
# SYNC_BREAKER_THRESHOLD=0.5
# SYNC_BREAKER_MIN_SAMPLES=6

# Per-step timeouts, SYNC_TIMEOUT_<STEP>_MS. Defaults:
# SYNC_TIMEOUT_LOGIN_MS=60000
# SYNC_TIMEOUT_STORES_FILE_MS=180000
# SYNC_TIMEOUT_LIST_FILES_MS=120000
# SYNC_TIMEOUT_HEAD_CHECK_MS=30000
# SYNC_TIMEOUT_DOWNLOAD_MS=300000
# SYNC_TIMEOUT_DECOMPRESS_MS=60000
# SYNC_TIMEOUT_PARSE_MS=120000
# SYNC_TIMEOUT_VALIDATE_MS=30000
# SYNC_TIMEOUT_WRITE_DB_MS=300000
# SYNC_TIMEOUT_FINALIZE_MS=60000
# SYNC_TIMEOUT_RECOMPUTE_NAMES_MS=900000

# Validation before writing (a failing file is not written).
# SYNC_MIN_ITEMS_FULL=100
# SYNC_MAX_ITEM_DROP_RATIO=0.5
# SYNC_MAX_PRICE=10000
# SYNC_MAX_BAD_PRICE_RATIO=0.01
# SYNC_MAX_ITEMS_PER_FILE=50000

# Retention (days).
# SYNC_RETENTION_DAYS=90
# SYNC_RAW_RETENTION_DAYS=14

# Dashboard warnings.
# SYNC_LONG_RUN_WARN_MINUTES=45
# SYNC_HEALTH_DELTAS_MAX_AGE_HOURS=2
# SYNC_HEALTH_FULL_MAX_AGE_HOURS=26

# GitHub issues for runs that end partial/failed (optional).
# SYNC_ISSUES_GITHUB_TOKEN=
# SYNC_ISSUES_GITHUB_REPO=owner/repo

# Lowest level printed to stdout (everything goes to the DB): debug|info|warn|error
# SYNC_LOG_LEVEL=info
